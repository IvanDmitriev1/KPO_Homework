<LumexCard Class="p-4">
	<EditForm Model="_model" OnValidSubmit="SubmitAsync">
		<DataAnnotationsValidator />
			
		<div class="space-y-4">
			<ValidationSummary class="text-red-500" />

			<LumexNumbox @bind-Value="_model.Amount"
			             Label="Amount"
			             Required="true"
			             Placeholder="Enter the price"
			             Variant="InputVariant.Outlined"/>

			<LumexTextbox @bind-Value="_model.Description"
			              Label="Descriptioon"
			              Placeholder="Enter description"
			              Variant="InputVariant.Outlined"/>

			<div class="flex items-center gap-3 pt-2">
				<LumexButton Type="ButtonType.Submit"
				             Color="ThemeColor.Primary"
				             Disabled="@_isBusy"
				             Class="justify-self-end">
					@if (_isBusy)
					{
						<span class="animate-pulse">Creating...</span>
					}
					else
					{
						<span>Create Order</span>
					}
				</LumexButton>
			</div>
		</div>
	</EditForm>
</LumexCard>

@code
{
	public sealed class CreateOrderFormModel
	{
		[Range(1, 100000000)]
		public decimal Amount{ get; set; }

		[Required, MinLength(1)]
		public string Description { get; set; } = string.Empty;
	}

	[Parameter, EditorRequired]
	public EventCallback<CreateOrderFormModel> OnOrder { get; set; }

	private CreateOrderFormModel _model = new();
	private bool _isBusy;


	private async Task SubmitAsync()
	{
		_isBusy = true;
		await OnOrder.InvokeAsync(_model);

		_isBusy = false;
		_model = new CreateOrderFormModel();
	}
}
