<LumexCard Class="p-4 flex flex-row flex-wrap justify-between gap-1.5">
	<TransactionTypeBadge Type="Item.Type" />

	<div class="mt-2 text-sm text-slate-700">
		<span class="font-medium">Date:</span>
		<span class="ml-1">@Item.CreatedAt.ToLocalTime().ToString("g")</span>
	</div>

	<div class="md:w-full mt-1 text-sm text-slate-700">
		<span class="font-medium">Reference:</span>
		<span class="ml-1 font-mono text-xs">@Item.ReferenceId</span>
	</div>
	
	<div class="@AmountCss">
		@AmountText
	</div>
	
	<TransactionStatusBadge Status="Item.Status"></TransactionStatusBadge>
</LumexCard>

@code
{
	[Parameter, EditorRequired]
	public PaymentTransactionDto Item { get; set; } = default!;

	private bool IsCredit => Item.Type == PaymentTransactionType.TopUp;

	private string AmountCss => IsCredit
		? "text-emerald-700 text-lg font-semibold"
		: "text-rose-700 text-lg font-semibold";

	private string AmountText
	{
		get
		{
			var sign = IsCredit ? "+" : "-";
			return $"{sign}{Item.Amount:0.00}";
		}
	}
}
